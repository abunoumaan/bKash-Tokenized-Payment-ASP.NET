<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- bKash Credentials -->
    <add key="bKashAppKey" value="YOUR_APP_KEY" />
    <add key="bKashAppSecret" value="YOUR_APP_SECRET" />
    <add key="bKashUsername" value="YOUR_USERNAME" />
    <add key="bKashPassword" value="YOUR_PASSWORD" />
    
    <!-- bKash API Configuration -->
    <!-- Sandbox: https://tokenized.sandbox.bka.sh -->
    <!-- Production: https://tokenized.bka.sh -->
    <add key="bKashBaseUrl" value="https://tokenized.sandbox.bka.sh" />
    
    <!-- Callback URL - আপনার সাইটের URL দিতে হবে -->
    <add key="CallbackUrl" value="http://localhost:xxxx/payment/agreement-callback" />
    
    <!-- Database Connection String -->
    <add key="DefaultConnection" value="Server=.;Database=bKashPayment;Integrated Security=true;" />
  </appSettings>

  <connectionStrings>
    <add name="DefaultConnection" connectionString="Server=.;Database=bKashPayment;Integrated Security=true;" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="2880" />
    </authentication>
  </system.web>

  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseExpires" httpExpires="Sun, 29 Mar 2020 00:00:00 GMT" />
    </staticContent>
  </system.webServer>
</configuration>
